		{ "Brightness curve", "Curva de brillo" },
		{ "How shadows and highlights are spread. HDR curves are for HDR screens only. Default: Auto.", "Cómo se reparten las sombras y las luces. Las curvas HDR son solo para pantallas HDR. Predeterminado: Auto." },
		{ "Maximum brightness", "Brillo máximo" },
		{ "The brightest your screen can go, mostly useful in HDR. Auto reads it from the screen. Default: Auto.", "El brillo máximo que alcanza tu pantalla, útil sobre todo en HDR. Auto lo lee de la pantalla. Predeterminado: Auto." },
		{ "Contrast", "Contraste" },
