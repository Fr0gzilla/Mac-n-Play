		{ "Reset the keys", "Restablecer las teclas" },
		{ "Click a key, then press the new key on your keyboard. The small box adds a second key for the same button. If that key already played another button, the two are swapped.", "Haz clic en una tecla y luego pulsa la nueva tecla en tu teclado. La casilla pequeña añade una segunda tecla para el mismo botón. Si esa tecla ya hacía otro botón, se intercambian." },
		{ "FEEL", "SENSACIONES" },
		{ "Vibration", "Vibración" },
		{ "How strongly the controller vibrates in game. Default: Normal.", "La fuerza con la que vibra el mando en el juego. Predeterminado: Normal." },
		{ "Fine vibrations of the DualSense (PS5 games). 100 % follows the console setting.", "Las vibraciones finas del DualSense (juegos de PS5). 100 % sigue el ajuste de la consola." },
		{ "BUTTON LAYOUT", "DISPOSICIÓN DE LOS BOTONES" },
		{ "Buttons by position", "Botones según su posición" },
