		{ "How strongly the controller vibrates in game. Default: Normal.", "L'intensità della vibrazione del controller in gioco. Predefinito: Normale." },
		{ "Fine vibrations of the DualSense (PS5 games). 100 % follows the console setting.", "Le vibrazioni precise del DualSense (giochi PS5). 100 % segue l'impostazione della console." },
		{ "BUTTON LAYOUT", "DISPOSIZIONE DEI TASTI" },
